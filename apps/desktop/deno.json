{
	"name": "@devshell/desktop",
	"exports": "./main.ts",
	"desktop": {
		"backend": "webview",
		"app": {
			"name": "Devshell",
			"identifier": "dev.devshell.desktop"
		}
	},
	"tasks": {
		"desktop": "deno desktop --hmr --backend webview -A --no-check --include npm:isomorphic-git --include npm:fflate main.ts",
		"test": "deno test -A smoke/",
		"smoke:resolve": "deno test -A smoke/resolve.test.ts",
		"smoke:bun-engine": "deno test -A smoke/bun-engine.test.ts",
		"smoke:session": "deno test -A smoke/session.test.ts",
		"smoke:process-tree": "deno test -A smoke/process-tree.test.ts",
		"smoke:sync": "deno test -A smoke/project-sync.test.ts",
		"smoke:bun-download": "deno run -A smoke/bun-download.ts",
		"smoke:pipeline": "deno test -A smoke/pipeline.test.ts"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@1.0.15",
		"@std/fs": "jsr:@std/fs@1.0.24",
		"@std/path": "jsr:@std/path@1.1.6",
		"isomorphic-git": "npm:isomorphic-git@1.42.2",
		"isomorphic-git/http/node": "npm:isomorphic-git@1.42.2/http/node",
		"fflate": "npm:fflate@0.8.2"
	},
	"compilerOptions": {
		"lib": ["deno.window", "deno.ns"],
		"strict": true
	}
}
