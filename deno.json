{
	"workspace": ["./apps/desktop", "./packages/client"],
	"nodeModulesDir": "auto",
	"minimumDependencyAge": "0",
	"tasks": {
		"desktop": "deno task --cwd apps/desktop desktop",
		"test": "deno task --cwd apps/desktop test",
		"smoke:resolve": "deno task --cwd apps/desktop smoke:resolve",
		"smoke:bun-engine": "deno task --cwd apps/desktop smoke:bun-engine",
		"smoke:sync": "deno task --cwd apps/desktop smoke:sync",
		"smoke:bun-download": "deno task --cwd apps/desktop smoke:bun-download",
		"smoke:pipeline": "deno task --cwd apps/desktop smoke:pipeline"
	},
	"compilerOptions": {
		"strict": true
	}
}
